# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Notion Integration
NOTION_TOKEN=your_notion_integration_token_here
NOTION_ROOT_PAGE_ID=your_notion_root_page_id_here

# Optional Configurations
# Timeout in seconds for Gemini File API uploads and LLM inference (default: 300)
GEMINI_TIMEOUT_SECONDS=300

# Gemini model ID (default: gemini-2.5-flash with auto-fallback to gemini-2.0-flash / gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Adaptive Dispatcher threshold in raw characters (default: 30000, ~7500 words)
# Below this threshold: Single-Call mode (1 API call). Above: Two-Stage mode (2 API calls to prevent 8k output token saturation)
SPLIT_THRESHOLD_CHARS=30000

# CLI interaction language: EN (English, default) or IT (Italian)
CLI_LANGUAGE=EN

# Web Cockpit Local Domain and Networking (Optional)
# Domain mapped in hosts file (default: phdprof.test)
WEB_DOMAIN=phdprof.test
# Web server listening host (default: 127.0.0.1)
WEB_HOST=127.0.0.1
# Web server port (default: 443 when certs exist for HTTPS, or 80 for HTTP)
WEB_PORT=80



# Cloudflare R2 / S3 Image Hosting (Optional - For high-DPI inline slide diagrams, see docs/CLOUD_STORAGE.md)
# R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY=your_access_key_id
# R2_SECRET_KEY=your_secret_access_key
# R2_BUCKET_NAME=your_bucket_name
# R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev
